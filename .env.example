# Secure AI ortam ayarlari
# Bu dosyayi .env olarak kopyalayin. Gercek .env dosyasini Git'e eklemeyin.

# Mevcut NVIDIA NIM anahtariniz degistirilmeden burada kullanilir.
NVIDIA_API_KEY=

# Oturum girisi. Bos APP_PASSWORD ve APP_PASSWORD_HASH birakilirsa ilk
# calistirmada guclu bir sifre otomatik uretilir ve
# .runtime/initial_credentials.txt dosyasina yazilir.
APP_USERNAME=admin
APP_PASSWORD=
APP_PASSWORD_HASH=

# Bos birakilirsa kalici ve rastgele bir anahtar .runtime altinda uretilir.
APP_SECRET_KEY=

# Yalnizca HTTPS arkasinda calistirirken 1 yapin.
SESSION_COOKIE_SECURE=0

# Opsiyonel Gunicorn ayarlari
BIND=0.0.0.0:5001
WEB_CONCURRENCY=4
